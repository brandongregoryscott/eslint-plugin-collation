import { job, step, workflow } from "gagen";

const TEST = job("test", {
    runsOn: "ubuntu-latest",
    steps: [
        step({ uses: "actions/checkout@v7" }),
        step({
            name: "Setup node 24.12.0",
            uses: "actions/setup-node@v7",
            with: { "node-version": "24.12.0" },
        }),
        step({ run: "npm ci" }),
        step({ run: "npm install -g yalc" }),
        step({ run: "npm run build" }),
        step({ run: "yalc publish --no-scripts" }),
        step({ run: "yalc add eslint-plugin-collation" }),
        step({
            uses: "AriPerkkio/eslint-remote-tester-run-action@v6",
            with: {
                "issue-title": "Results of scheduled smoke test",
                "eslint-remote-tester-config":
                    "eslint-remote-tester.config.mjs",
            },
        }),
    ],
});

workflow({
    name: "smoke-test",
    on: {
        workflow_dispatch: {},
        // Every day at 01:00 UTC.
        schedule: [{ cron: "0 1 * * *" }],
    },
    jobs: [TEST],
}).writeOrLint({
    filePath: new URL("./smoke-test.generated.yml", import.meta.url),
    header: "# Generated by smoke-test.mts. Run npm run ci:generate; do not edit directly.",
});
