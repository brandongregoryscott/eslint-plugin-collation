import { job, step, workflow, expr } from "gagen";

const RELEASE = job("release", {
    runsOn: "ubuntu-latest",
    if: expr("github.ref").equals("refs/heads/main"),
    permissions: {
        contents: "write",
        issues: "write",
        "pull-requests": "write",
        "id-token": "write",
    },
    steps: [
        step({ uses: "actions/checkout@v7", with: { "fetch-depth": 0 } }),
        step({
            name: "Setup node",
            uses: "actions/setup-node@v7",
            with: { "node-version-file": ".nvmrc", cache: "npm" },
        }),
        step({ name: "Install packages", run: "npm ci" }),
        step({ name: "Build", run: "npm run build:dist" }),
        step({
            name: "Release",
            env: { GITHUB_TOKEN: expr("secrets.GITHUB_TOKEN") },
            run: "npm run semantic-release",
        }),
    ],
});

workflow({
    name: "release",
    on: {
        push: {
            branches: ["main"],
            paths: [
                "src/**",
                ".github/workflows/release.generated.yml",
                ".releaserc",
                "package.json",
                "package-lock.json",
            ],
        },
        workflow_dispatch: {},
    },
    jobs: [RELEASE],
    concurrency: { group: "release", cancelInProgress: false },
}).writeOrLint({
    filePath: new URL("./release.generated.yml", import.meta.url),
    header: "# Generated by release.mts. Run npm run ci:generate; do not edit directly.",
});
