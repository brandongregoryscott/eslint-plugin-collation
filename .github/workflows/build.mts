import { job, step, workflow } from "gagen";

const SHARED_STEPS = [
    step({ uses: "actions/checkout@v7" }),
    step({
        name: "Setup node",
        uses: "actions/setup-node@v7",
        with: { "node-version-file": ".nvmrc", cache: "npm" },
    }),
    step({ name: "Install packages", run: "npm ci" }),
];
const BUILD = job("build", {
    runsOn: "ubuntu-latest",
    steps: [
        ...SHARED_STEPS,
        step({ name: "Check workflow generation", run: "npm run ci:check" }),
        step({ name: "Format", run: "npm run format:check" }),
        step({ name: "Lint", run: "npm run lint" }),
        step({ name: "Build", run: "npm run build:dist" }),
        step({ name: "Test", run: "npm test" }),
    ],
});

// Other development-only lint plugins do not yet support ESLint 10.
// Override the test dependencies without changing the lockfile.
const ESLINT_10_DEPENDENCIES = [
    "eslint@10.15.0",
    "typescript-eslint@8.72.2",
    "@typescript-eslint/eslint-plugin@8.72.2",
    "@typescript-eslint/parser@8.72.2",
    "@typescript-eslint/rule-tester@8.72.2",
    "@typescript-eslint/utils@8.72.2",
].join(" ");

const BUILD_ESLINT_10 = job("build-eslint-10", {
    runsOn: "ubuntu-latest",
    steps: [
        ...SHARED_STEPS,
        step({
            name: "Install ESLint 10",
            run: `npm install --no-save --package-lock=false --legacy-peer-deps ${ESLINT_10_DEPENDENCIES}`,
        }),
        step({ name: "Test", run: "npm test" }),
    ],
});

workflow({
    name: "build",
    on: {
        pull_request: { branches: ["main"] },
        push: { branches: ["main"] },
        workflow_dispatch: {},
    },
    jobs: [BUILD, BUILD_ESLINT_10],
}).writeOrLint({
    filePath: new URL("./build.generated.yml", import.meta.url),
    header: "# Generated by build.mts. Run npm run ci:generate; do not edit directly.",
});
